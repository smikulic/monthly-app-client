# PostHog product analytics.
# The host must be the EU region — this app's users are EU consumers and their
# financial behaviour should not leave EU jurisdiction.
VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Nothing is captured from localhost, so development traffic stays out of the
# real project. Set this to capture anyway when verifying a new event.
# VITE_POSTHOG_DEBUG=true

VITE_SENTRY_DSN=your_sentry_token_here

# Authentication Token Keys
VITE_AUTH_TOKEN_KEY=your-custom-auth-token-key
VITE_AUTH_TOKEN_USER_KEY=your-custom-auth-user-key

# API
VITE_API_PRODUCTION=api_url

# App Version (optional, defaults to 0.1.0)
VITE_APP_VERSION=0.1.0

